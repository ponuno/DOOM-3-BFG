; New 3DS vertex shader, stage 3: textured world lit per vertex.
;   v0 = position (float3)
;   v1 = normal (ubyte4, 0..255 -> -1..1)
;   v2 = st (the two raw half floats of idDrawVert, read as signed shorts)
;
; One program for both passes, chosen by bool uniforms (all in model space). The passes branch
; (ifu): each vertex runs only its pass's work. Selecting the results with arithmetic made every
; vertex of every pass pay for both (~68 instructions; light passes run on 150k+ triangles a
; frame in big rooms, and vertex work, not pixels, was their cost).
;   fill pass  (isFill): texcoord1 = texcoord2 = st (unit 1 alpha mask,
;              unit 2 diffuse), colour = surfColor
;   light pass (!isFill): texcoord0 = light projection (s, t, q) for
;              unit 0, texcoord1 = (falloff, 0.5) for unit 1, texcoord2 = st for
;              the diffuse map on unit 2, colour = surfColor * max(0, N.L)
;              (N.L replaced by 1 when lightOrigin.w = 0, ambient lights)
;   perPixelQ: unit 0 divides by q per pixel (projection texture),
;   otherwise: s/q, t/q are computed here and q = 1

; Uniforms
.fvec mvp[4], surfColor
.fvec lightOrigin, lightS, lightT, lightQ, lightF
.bool isFill, perPixelQ
; half float exponent table, set once by n3ds_gpu.c:
;   pow2[e] = ( 2^(e-15), 2^(e-25) ) so that value = x + mantissa * y
;   pow2[0] = ( 0, 2^-24 ) (zero and denormals)
.fvec pow2[32]

; Constants
.constf consts(1.0, 0.0, 0.0078431373, -1.0)
.constf halfK(32768.0, 0.0009765625, -1024.0, -2.0)
.constf lightK(0.0001, 0.5, -8.0, 0.0)
.alias  ones   consts.xxxx
.alias  zeros  consts.yyyy
.alias  bscale consts.zzzz
.alias  bbias  consts.wwww

; Outputs
.out outpos position
.out outclr color
.out outtc0 texcoord0.xy
.out -      texcoord0w outtc0.p
.out outtc1 texcoord1
.out outtc2 texcoord2

; Inputs
.alias inpos v0
.alias innrm v1
.alias inst  v2

.proc main
	; r0 = (xyz, 1)
	mov r0.xyz, inpos
	mov r0.w,   ones

	; outpos = mvp * r0
	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	; ---- st: half float bits -> float, into r11.xy ----
	; r5 = raw bits as signed integers (-32768..32767)
	mov r5, inst
	; r6 = 1 where the sign bit is set
	slt r6, r5, zeros
	; r7 = bits without the sign (0..32767)
	mad r7, r6, halfK.xxxx, r5
	; r8 = exponent = floor( bits / 1024 )
	mul r8, halfK.yyyy, r7
	flr r8, r8
	; r9 = mantissa = bits - exponent * 1024
	mad r9, r8, halfK.zzzz, r7
	mova a0.xy, r8.xy
	; r6 = sign factor 1 - 2 * negative (also keeps mova and its use apart)
	mul r6, halfK.wwww, r6
	add r6, ones, r6
	mov r10, pow2[a0.x]
	mad r11.x, r9.x, r10.y, r10.x
	mov r10, pow2[a0.y]
	mad r11.y, r9.y, r10.y, r10.x
	mul r11.xy, r11.xy, r6.xy
	mov r11.zw, zeros
	mov outtc2, r11

	ifu isFill
		; texcoord1 = st (alpha mask), unit 0 unused, colour = surfColor
		mov outtc1, r11
		mov outtc0, consts.yyxx
		mov outclr, surfColor
	.else
		; ---- light projection ----
		; r1 = ( s, t, q, falloff )
		dp4 r1.x, lightS, r0
		dp4 r1.y, lightT, r0
		dp4 r1.z, lightQ, r0
		dp4 r1.w, lightF, r0
		; r2.x = 1 when q is in front of the light
		slt r2, lightK.xxxx, r1.zzzz
		ifu perPixelQ
			; raw ( s, t, q ): unit 0 divides per pixel
			mov r3.xyz, r1.xyz
		.else
			; ( s / q, t / q, 1 ) with q kept away from 0
			max r4, lightK.xxxx, r1.zzzz
			rcp r4, r4.x
			mul r3.xy, r1.xy, r4.xy
			mov r3.z, ones
		.end
		; behind the light: (-8, -8, 1), outside the zero-clamped texture
		mov r4.xy, lightK.zz
		mov r4.z, ones
		add r3.xyz, r3.xyz, -r4.xyz
		mad r3.xyz, r3.xyz, r2.xxx, r4.xyz
		mov r3.w, ones
		mov outtc0, r3

		; texcoord1 = ( falloff, 0.5 )
		mov r4.x, r1.w
		mov r4.y, lightK.y
		mov r4.zw, zeros
		mov outtc1, r4

		; ---- per-vertex N.L ----
		; r1 = normal in -1..1
		mov r1, innrm
		mul r1, bscale, r1
		add r1, bbias, r1
		; r2 = normalize( lightOrigin - position )
		add r2.xyz, lightOrigin.xyz, -r0.xyz
		dp3 r3.x, r2.xyz, r2.xyz
		max r3.x, lightK.x, r3.x
		rsq r3.x, r3.x
		mul r2.xyz, r2.xyz, r3.xxx
		; r3.x = max( 0, N.L )
		dp3 r3.x, r1.xyz, r2.xyz
		max r3.x, zeros, r3.x
		; r3.x = w * N.L + ( 1 - w )
		add r3.x, -ones, r3.x
		mul r3.x, lightOrigin.w, r3.x
		add r3.x, ones, r3.x

		; outclr = surfColor * shade, alpha from surfColor
		mul r4, surfColor, r3.xxxx
		mov r4.w, surfColor.w
		mov outclr, r4
	.end

	end
.end
